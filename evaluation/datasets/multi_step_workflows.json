[
  {
    "id": "WORKFLOW-01",
    "category": "multi_step_workflows",
    "session_name": "Full End-to-End Customer Purchase Journey",
    "description": "Search -> Details -> Add to Cart -> Initiate Checkout -> HITL Address Confirmation",
    "turns": [
      {
        "turn": 1,
        "user_input": "suggest some mobiles under 80000",
        "expected_tool": "search_products",
        "expected_args": {"category": "mobiles", "max_price": 80000.0},
        "expected_route": "shopping_agent",
        "expected_business_outcome": "Returns OnePlus 12 and Pixel 8 Pro"
      },
      {
        "turn": 2,
        "user_input": "tell me more details about product 9",
        "expected_tool": "get_product_details",
        "expected_args": {"product_id": 9},
        "expected_route": "shopping_agent",
        "expected_business_outcome": "Returns specs of OnePlus 12"
      },
      {
        "turn": 3,
        "user_input": "add 1 unit of product 9 to cart",
        "expected_tool": "add_to_cart",
        "expected_args": {"product_id": 9, "quantity": 1},
        "expected_route": "shopping_agent",
        "expected_business_outcome": "Product 9 added to cart"
      },
      {
        "turn": 4,
        "user_input": "checkout",
        "expected_tool": "checkout_cart",
        "expected_args": {},
        "expected_route": "shopping_agent",
        "expected_business_outcome": "HITL challenge displayed with address choices 1 and 2"
      },
      {
        "turn": 5,
        "user_input": "2",
        "context": "Which address you'd like to use (reply with 1 or 2)?",
        "expected_route": "shopping_agent",
        "expected_business_outcome": "Address 2 selected and order confirmed"
      }
    ]
  },
  {
    "id": "WORKFLOW-02",
    "category": "multi_step_workflows",
    "session_name": "Search -> Compare -> Add Selected Product Journey",
    "description": "Discovery -> 2-phone comparison -> Selection and addition to cart",
    "turns": [
      {
        "turn": 1,
        "user_input": "show me flagship phones",
        "expected_tool": "search_products",
        "expected_args": {"category": "mobiles"},
        "expected_route": "shopping_agent",
        "expected_business_outcome": "Lists flagship phones"
      },
      {
        "turn": 2,
        "user_input": "compare OnePlus 12 5G and Samsung Galaxy S24 Ultra",
        "expected_route": "comparison_pipeline",
        "expected_business_outcome": "Returns comparison table"
      },
      {
        "turn": 3,
        "user_input": "add the first one to my cart",
        "context": "Comparison: 1. OnePlus 12 5G, 2. Samsung Galaxy S24 Ultra",
        "expected_tool": "add_to_cart",
        "expected_args": {"product_id": 9, "quantity": 1},
        "expected_route": "shopping_agent",
        "expected_business_outcome": "Resolves 'first one' to OnePlus 12 (ID 9) and adds to cart"
      }
    ]
  },
  {
    "id": "WORKFLOW-03",
