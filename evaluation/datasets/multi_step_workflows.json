        "expected_tool": "check_inventory",
        "expected_args": {"product_id": 2},
        "expected_route": "shopping_agent",
        "expected_business_outcome": "Confirms in stock"
      },
      {
        "turn": 3,
        "user_input": "add it to my cart",
        "context": "Apple MacBook Pro 14 M3 is in stock.",
        "expected_tool": "add_to_cart",
        "expected_args": {"product_id": 2, "quantity": 1},
        "expected_route": "shopping_agent",
        "expected_business_outcome": "Adds MacBook Pro to cart"
      },
      {
        "turn": 4,
        "user_input": "view my cart",
        "expected_tool": "view_cart",
        "expected_args": {},
